{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "volix-proxy",
  "compatibility_date": "2025-08-03",
  "main": "./src/index.tsx",
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
